[Unit]
Description=NOIR Internet Cafe
After=network.target mysql.service

[Service]
Type=simple
User=noir
Group=noir
WorkingDirectory=/opt/noir
ExecStart=/opt/noir/.venv/bin/python /opt/noir/app.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true

[Install]
WantedBy=multi-user.target
